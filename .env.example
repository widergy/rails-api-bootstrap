# Copy to .env and fill in. dotenv-rails loads it in development and test; .env is
# gitignored. In the deployed environments these come from AWS Secrets Manager
# through config/aws_secrets_manager.rb.
#
# Everything here has a working default for local development, so an empty .env
# boots the app. The values that have no default are marked.

# --- Database -----------------------------------------------------------------
# database.yml reads the user from DB_USERNAME and the host from DB_1_PORT_5432_TCP_ADDR.
DB_USERNAME=rails-api-bootstrap
DB_PASSWORD=
DB_1_PORT_5432_TCP_ADDR=localhost
DB_1_PORT_5432_TCP_PORT=5432
DB_POOL=5

# --- Redis --------------------------------------------------------------------
# Used by Sidekiq, by the health check and by the production cache store.
REDIS_URL=redis://127.0.0.1:6379

# --- Rails --------------------------------------------------------------------
# Required in production, where the app will not boot without it. In development
# and test Rails generates one and keeps it in tmp/.
SECRET_KEY_BASE=
RAILS_MAX_THREADS=5
# 0 keeps Puma single process. The deployed environments set it to the pod's cores.
WEB_CONCURRENCY=0
RAILS_LOG_LEVEL=debug

# --- Sidekiq ------------------------------------------------------------------
# Basic auth for the /sidekiq panel. Mandatory outside development.
SIDEKIQ_USERNAME=rails-api-bootstrap
SIDEKIQ_PASSWORD=rails-api-bootstrap
SIDEKIQ_CONCURRENCY=5

# --- Application --------------------------------------------------------------
CURRENT_HOST=localhost:3000
# Colon separated list, e.g. https://a.com:https://b.com. Empty disables CORS.
CORS_ORIGINS=
REQUEST_RETRIES=3
RACK_ATTACK_ENABLED=false
RACK_ATTACK_MAX_REQUESTS_PER_SECOND=5

# --- Rollbar ------------------------------------------------------------------
# Leave empty in development so nothing is reported.
ROLLBAR_ACCESS_TOKEN=
ROLLBAR_ENVIRONMENT=development

# --- AWS ----------------------------------------------------------------------
# Set to any value to pull the secrets of the Bootstrap-<ELK_ENV> prefix from AWS
# Secrets Manager into ENV before boot. Off in local development.
ENABLE_AWS_SECRETS=
ELK_ENV=development

# --- Elastic APM --------------------------------------------------------------
ELASTIC_APM_ENABLED=false
